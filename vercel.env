# =============================================================================
# Strike Berlin — variáveis da Vercel (Settings → Environment Variables)
# Atualizado em 05/10/2026. Sem segredos neste arquivo: eles ficam comentados
# e são cadastrados à mão. Cole o bloco PRODUCTION marcando "Production" e o
# bloco PREVIEW marcando "Preview". Mudou NEXT_PUBLIC_*? Precisa de novo deploy.
# Não ponha comentário na mesma linha do valor (a Vercel guarda como valor).
# =============================================================================

# --- PRODUCTION ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.strikeberlin.com.br
NEXT_PUBLIC_TRACKING_MODE=direct
NEXT_PUBLIC_CONSENT_MODE=off
NEXT_PUBLIC_SERVER_PAGEVIEW=true

# Meta: pixel "Pixel Eleven Tickets" (o mesmo do site de reservas)
NEXT_PUBLIC_META_PIXEL_ID=2138722490022940
META_API_VERSION=v26.0

# Google Ads: conta 800-629-7198. Ações criadas em 05/10/2026, todas secundárias.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18124180717
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=vtpmCLqluZIdEO2ZpMJD
NEXT_PUBLIC_GOOGLE_ADS_RESERVATION_LABEL=I6T9CMqvwJIdEO2ZpMJD
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=peTiCM2vwJIdEO2ZpMJD

# Medição entre domínios com o site de reservas
NEXT_PUBLIC_LINKER_DOMAINS=eleventickets.com

# GA4: lead pelo navegador até existir a chave do Measurement Protocol
NEXT_PUBLIC_GA4_LEAD_SOURCE=browser

# CRM: liga quando o Kommo existir (ver README → "Ligando o Kommo")
CRM_PROVIDER=none

# --- SEGREDOS (cadastrar à mão, nunca neste arquivo) -------------------------
# Obrigatório em Production — sem ele o build recusa:
# META_CAPI_ACCESS_TOKEN=  → Gerenciador de Eventos → pixel 2138722490022940 → Configurações → API de Conversões → Gerar token
# Opcional, libera GET /api/tracking-health:
# TRACKING_HEALTH_TOKEN=   → qualquer texto aleatório longo

# --- PENDENTE: GA4 da Strike (conta nova, aguardando aceite dos termos) --------
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=   → G-... do fluxo web www.strikeberlin.com.br
# GA4_API_SECRET=                   → segredo; com ele, trocar NEXT_PUBLIC_GA4_LEAD_SOURCE para server

# --- PREVIEW ------------------------------------------------------------------
# Os mesmos valores de cima, mais o código de teste da Meta (aba "Testar
# eventos" do pixel). NUNCA em Production: o build recusa.
# META_TEST_EVENT_CODE=TEST12345
