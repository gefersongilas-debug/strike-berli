# =============================================================================
# Site Next.js — tracking + CRM
# Copie para .env.local (dev) e cadastre as MESMAS chaves na Vercel:
#   Settings → Environment Variables (marque Production / Preview conforme o caso)
#
# Toda variável é checada antes do build (npm run check:tracking). Configuração
# errada = build quebra com a mensagem do que corrigir. Nunca coloque aspas.
#
# NEXT_PUBLIC_* vai para o JavaScript do site (público). Mudou? Precisa de novo deploy.
# Sem prefixo = segredo, só no servidor.
# =============================================================================

# --- Site -----------------------------------------------------------------------
# Domínio final, com https e sem barra no fim. Usado como event_source_url e para
# recusar eventos vindos de outro domínio.
NEXT_PUBLIC_SITE_URL=https://www.cliente.com.br

# --- Modo de tracking no browser ---------------------------------------------------
# direct → o próprio Next carrega Meta Pixel + gtag (GA4/Google Ads). Não usa GTM.
# gtm    → o Next carrega só o GTM e empurra eventos no dataLayer (trk_page_view,
#          trk_lead, trk_contact, trk_view_content) com event_id. As tags ficam no GTM.
# Em ambos os modos o server side (CAPI, GA4 MP, Google Ads API) sai do Next.
NEXT_PUBLIC_TRACKING_MODE=direct

# Obrigatório no modo gtm. Ignorado (e avisado) no modo direct.
NEXT_PUBLIC_GTM_ID=

# --- Meta ----------------------------------------------------------------------------
# Id do pixel/dataset. Usado pelo pixel (modo direct) e pela CAPI (sempre).
NEXT_PUBLIC_META_PIXEL_ID=
# Gerenciador de Eventos → Configurações → API de Conversões → Gerar token. SEGREDO.
META_CAPI_ACCESS_TOKEN=
META_API_VERSION=v26.0
# Só em Preview/Development, para ver eventos em "Testar eventos".
# Em Production o build QUEBRA se isto estiver definido (evento de teste não otimiza).
META_TEST_EVENT_CODE=

# --- GA4 -----------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Admin → Fluxos de dados → (fluxo) → Chaves secretas da API do Measurement Protocol. SEGREDO.
GA4_API_SECRET=
# De onde sai o generate_lead para o GA4 (o GA4 NÃO deduplica, então é um OU outro):
#   server  → Measurement Protocol (resiste a bloqueador; padrão)
#   browser → gtag/GTM
NEXT_PUBLIC_GA4_LEAD_SOURCE=server

# --- Google Ads: tag no browser (modo direct) --------------------------------------
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Rótulo da conversão de lead (a parte depois da "/" em AW-123/AbCdEf).
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Rótulo da conversão de clique em "Reservar" (ida ao Eleven Tickets). Opcional.
# Crie uma ação própria (Site → clique), nunca a mesma do lead. Contagem: uma por clique.
NEXT_PUBLIC_GOOGLE_ADS_RESERVATION_LABEL=
# Rótulo da conversão de clique no WhatsApp/telefone. Opcional, ação própria.
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=

# --- Microsoft Clarity (mapa de calor e gravação de sessão) --------------------------
# Id do projeto: clarity.microsoft.com → Settings → Overview → Project ID. Vazio = não carrega.
# Só no modo direct. Campos de formulário já saem mascarados na gravação.
NEXT_PUBLIC_CLARITY_ID=

# --- Medição entre domínios (modo direct) --------------------------------------------
# Domínios que recebem o _gl do gtag (client id do GA4 + gclid), separados por vírgula.
# Os links de reserva também levam UTM/gclid/fbclid na URL (src/lib/tracking/outbound.ts).
NEXT_PUBLIC_LINKER_DOMAINS=eleventickets.com

# --- Google Ads: upload de conversão via API (server side) --------------------------
# Tudo ou nada: preencher só parte quebra o build.
# A ação de conversão precisa ser "Importação → Cliques" (UPLOAD_CLICKS) e diferente
# da ação usada pela tag. Deixe só UMA delas como primária.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# 10 dígitos, sem hífen.
GOOGLE_ADS_CUSTOMER_ID=
# MCC que gerencia a conta (se o acesso for via MCC). 10 dígitos, sem hífen.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_API_VERSION=v25

# --- Consentimento (LGPD) -------------------------------------------------------------
# off    → sem banner; tudo liberado.
# banner → banner de cookies; pixel, Consent Mode v2 e server side só enviam dados
#          de anúncio depois do "Aceitar". UTMs continuam indo para o CRM.
NEXT_PUBLIC_CONSENT_MODE=off

# PageView também pela CAPI (cada pageview = 1 invocação de função na Vercel).
NEXT_PUBLIC_SERVER_PAGEVIEW=true

# --- CRM -------------------------------------------------------------------------------
# none | webhook | rdstation | kommo
CRM_PROVIDER=webhook
# webhook: POST JSON com lead + UTMs + gclid/fbc (n8n, Make, Zapier, backend próprio).
CRM_WEBHOOK_URL=
# Assina o corpo: header X-Signature: sha256=<hmac>. SEGREDO.
CRM_WEBHOOK_SECRET=
# rdstation: RD Station Marketing → Integrações → Chave de API pública. SEGREDO.
RDSTATION_API_KEY=
RDSTATION_CONVERSION_IDENTIFIER=site-lead

# kommo: cria contato + negócio + nota com respostas e UTMs.
# Token: Kommo → Configurações → Integrações → Criar integração → integração privada
#        → aba "Chaves e escopos" → Gerar token de longa duração. SEGREDO.
# Só o subdomínio: "minhaempresa" para minhaempresa.kommo.com.
KOMMO_SUBDOMAIN=
KOMMO_ACCESS_TOKEN=
# Funil e etapa de entrada (id na URL do funil). Vazio = 1ª etapa do funil principal.
KOMMO_PIPELINE_ID=
KOMMO_STATUS_ID=
# Usuário responsável pelo negócio e pelo contato (opcional).
KOMMO_RESPONSIBLE_USER_ID=
# Tags do negócio, separadas por vírgula. Vazio = site
KOMMO_TAGS=
# Liga chaves a campos personalizados do negócio (JSON, sem aspas externas).
# Chaves: as perguntas do formulário (name="fields.<chave>") e a atribuição
# (utm_source, utm_medium, utm_campaign, utm_content, utm_term, gclid, fbc, landing_page…).
# Ex.: {"entrada":123456,"parcela":123457,"utm_source":654321}
# O check:tracking:live lista os ids dos campos de UTM da conta.
KOMMO_FIELD_MAP=

# --- Operação ----------------------------------------------------------------------------
# Libera GET /api/tracking-health (header Authorization: Bearer <token>). SEGREDO.
TRACKING_HEALTH_TOKEN=
# Pula a checagem de build. Só para emergência.
SKIP_TRACKING_CHECK=
